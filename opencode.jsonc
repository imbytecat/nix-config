{
	"$schema": "https://opencode.ai/config.json",
	"lsp": {
		"just": {
			"command": ["just-lsp"],
			"extensions": [""]
		},
		// 与 .vscode/settings.json 保持一致：nixd 启动后会请求 workspace/configuration
		// 的 "nixd" section，opencode 从 initialization.nixd 取值返回，故须多包一层
		"nixd": {
			"command": ["nixd"],
			"extensions": [".nix"],
			"initialization": {
				"nixd": {
					"formatting": {
						"command": ["nixfmt"]
					},
					"nixpkgs": {
						"expr": "import (builtins.getFlake (toString ./.)).inputs.nixpkgs { }"
					},
					"options": {
						"nixos": {
							"expr": "(builtins.getFlake (toString ./.)).nixosConfigurations.awesome-pc.options"
						},
						"nix-darwin": {
							"expr": "(builtins.getFlake (toString ./.)).darwinConfigurations.awesome-macbook-air.options"
						},
						"home-manager": {
							"expr": "(builtins.getFlake (toString ./.)).nixosConfigurations.awesome-pc.options.home-manager.users.type.getSubOptions [ ]"
						}
					}
				}
			}
		}
	},
	"mcp": {
		"nixos": {
			"type": "local",
			"command": ["uvx", "mcp-nixos"]
		}
	}
}
